# 复制成 .env 后按需修改。.env 不要提交到 git。

# ---- 连接 ----
# Paper Gateway=4002, Paper TWS=7497, 实盘 Gateway=4001, 实盘 TWS=7496
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=10

# 唯一能解除实盘保护的开关。保持 false，直到你真的准备好。
IB_ALLOW_LIVE=false

# 只读模式：连上后 API 无法下单。学习阶段建议 true。
IB_READONLY=true

# ---- 行情 ----
# 1=实时(需订阅) 2=frozen 3=延迟(免费) 4=延迟frozen
# 没买行情订阅就用 3
IB_MARKET_DATA_TYPE=3

# 指定账户（多账户时必填），单账户留空即可
IB_ACCOUNT=
