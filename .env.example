# 复制成 .env 后按需修改。.env 不要提交到 git。

# ---- 连接 ----
# Paper Gateway=4002, Paper TWS=7497, 实盘 Gateway=4001, 实盘 TWS=7496
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=10

# 唯一能解除实盘保护的开关。保持 false，直到你真的准备好。
IB_ALLOW_LIVE=false

# 只读模式：连上后 API 无法下单。学习阶段建议 true。
IB_READONLY=true

# ---- 行情 ----
# 1=实时(需订阅) 2=frozen 3=延迟(免费) 4=延迟frozen
# 没买行情订阅就用 3
IB_MARKET_DATA_TYPE=3

# 指定账户（多账户时必填），单账户留空即可
IB_ACCOUNT=

# ---- 无人值守作业（scripts/05_daily_job.py）----
# 定时作业必须和 dashboard / 手动脚本用不同的 clientId，否则会互相踢掉。
# 留空 = IB_CLIENT_ID + 1
IB_JOB_CLIENT_ID=

# Gateway 每天自动重启，重启窗口内 API 连不上。重试间隔要盖过重启耗时。
IB_CONNECT_RETRIES=5
IB_CONNECT_RETRY_DELAY=60

# 信号最多放几个日历日还算数。周末+假日=3天，留到4天。超过就拒绝交易。
JOB_MAX_SIGNAL_AGE_DAYS=4

# 对账容忍度：单标的实际权重与目标权重的绝对偏差超过它就告警
JOB_RECONCILE_TOLERANCE=0.02

# 出问题往哪推通知。留空 = 只写日志。任何接受 POST JSON 的 URL 都行。
NOTIFY_WEBHOOK=
