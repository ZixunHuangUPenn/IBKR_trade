# 复制成 .env 后按需修改。.env 不要提交到 git。

# ---- 连接 ----
# Paper Gateway=4002, Paper TWS=7497, 实盘 Gateway=4001, 实盘 TWS=7496
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=10

# 唯一能解除实盘保护的开关。保持 false，直到你真的准备好。
IB_ALLOW_LIVE=false

# 只读模式：连上后 API 无法下单。学习阶段建议 true。
IB_READONLY=true

# ---- 行情 ----
# 1=实时(需订阅) 2=frozen 3=延迟(免费) 4=延迟frozen
# 没买行情订阅就用 3
IB_MARKET_DATA_TYPE=3

# 指定账户（多账户时必填），单账户留空即可
IB_ACCOUNT=

# ---- 无人值守作业（scripts/05_daily_job.py）----
# 定时作业必须和 dashboard / 手动脚本用不同的 clientId，否则会互相踢掉。
# 留空 = IB_CLIENT_ID + 1
IB_JOB_CLIENT_ID=

# Gateway 每天自动重启，重启窗口内 API 连不上。重试间隔要盖过重启耗时。
IB_CONNECT_RETRIES=5
IB_CONNECT_RETRY_DELAY=60

# 信号最多放几个日历日还算数。周末+假日=3天，留到4天。超过就拒绝交易。
JOB_MAX_SIGNAL_AGE_DAYS=4

# 对账容忍度：单标的实际权重与目标权重的绝对偏差超过它就告警
JOB_RECONCILE_TOLERANCE=0.02

# 出问题往哪推通知。留空 = 只写日志。任何接受 POST JSON 的 URL 都行。
NOTIFY_WEBHOOK=

# ---- AI 自主选股（scripts/run_agent.ps1）----
# 下面每一条都是**硬上限**，不是给 agent 的建议。提案碰到任何一条就整份作废、
# 当天不交易（= 保持昨天的仓位）。改这里立刻生效，不用重注册计划任务。
#
# 当前是"激进"档。想保守一点：0.10 / 10 / 0.80 / 0.15
AGENT_MAX_WEIGHT=0.33          # 单标的权重上限
AGENT_MAX_POSITIONS=6          # 最多同时持有几个
AGENT_MAX_GROSS=1.00           # 总仓位上限，1.0 = 不加杠杆
AGENT_MAX_TURNOVER=0.50        # 单边换手上限/天 = Σ|Δw|÷2。空仓建满整个组合刚好 0.5

# 候选资格门槛。agent 可以自由提名任何美股代码，但过不了这几关就不进候选池。
AGENT_MAX_CANDIDATES=30        # 每天最多查多少个代码（也是 IBKR 限速保护）
AGENT_MIN_PRICE=10             # 最低股价
AGENT_MIN_DOLLAR_VOL=50000000  # 60日中位成交额下限，挡流动性陷阱
AGENT_MIN_HISTORY=500          # 至少多少根日线，不够就算不出 200 日线和 52 周高低

# 净值从历史高点回撤超过它就自动写 HALT 文件停止交易。
# 没有回测的策略只能靠这个当止损 —— 你不知道它什么时候失效，
# 只能规定亏到多少必须停下来人工看一眼。
AGENT_MAX_DRAWDOWN=0.20

# 额外拉黑的代码，逗号分隔。杠杆/反向 ETF 的内置名单在 agent/screen.py。
AGENT_DENY=

# 喂给 agent 看的历史决策条数。它需要看见自己昨天为什么买，
# 否则每天从零开始，结果是无意义的高换手。
AGENT_JOURNAL_DAYS=5
